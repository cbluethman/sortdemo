<Window x:Class="SortDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SortDemo.ViewModels"
        xmlns:vis="clr-namespace:SortDemo.Visualization"
        Title="Sorting Algorithm Visualizer"
        Width="1100" Height="750"
        MinWidth="800" MinHeight="500"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Top toolbar (shared) -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">

                <!-- SINGLE MODE controls -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsRaceMode, Converter={StaticResource InverseBoolToVisConverter}}">
                    <TextBlock Text="Algorithm:" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Algorithms}" SelectedItem="{Binding SelectedAlgorithm}"
                              Width="200" Margin="0,0,16,0"
                              IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Foreground="#1E1E2E"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="{Binding SortDirectionLabel}" Command="{Binding ToggleDirectionCommand}"
                            Background="#555566" Padding="10,8" Margin="0,0,12,0" FontWeight="Bold"/>

                    <Button Content="&#9654; Start" Command="{Binding StartCommand}" Margin="0,0,6,0"/>
                    <Button Content="&#9632; Stop" Command="{Binding StopCommand}" Margin="0,0,6,0" Background="#DC143C"/>
                    <Button Content="&#8634; Reset" Command="{Binding ResetCommand}" Background="#555566" Margin="0,0,16,0"/>
                </StackPanel>

                <!-- RACE MODE controls -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsRaceMode, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Left:" Margin="0,0,6,0" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Race.Algorithms}" SelectedItem="{Binding Race.SelectedLeft}" Width="165" Margin="0,0,10,0"
                              IsEnabled="{Binding Race.IsRunning, Converter={StaticResource InverseBoolConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Foreground="#1E1E2E"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="vs" Margin="0,0,10,0" FontWeight="Bold" FontSize="14" Foreground="#FFD700"/>
                    <TextBlock Text="Right:" Margin="0,0,6,0" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Race.Algorithms}" SelectedItem="{Binding Race.SelectedRight}" Width="165" Margin="0,0,10,0"
                              IsEnabled="{Binding Race.IsRunning, Converter={StaticResource InverseBoolConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Foreground="#1E1E2E"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="{Binding Race.SortDirectionLabel}" Command="{Binding Race.ToggleDirectionCommand}"
                            Background="#555566" Padding="10,8" Margin="0,0,10,0" FontWeight="Bold"/>
                    <Button Content="&#9654; Race!" Command="{Binding Race.StartCommand}" Margin="0,0,6,0" FontWeight="Bold"/>
                    <Button Content="&#9632; Stop" Command="{Binding Race.StopCommand}" Margin="0,0,6,0" Background="#DC143C"/>
                    <Button Content="&#8634; Reset" Command="{Binding Race.ResetCommand}" Background="#555566" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Race.WinnerText}" FontSize="14" FontWeight="Bold" Foreground="#FFD700" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Mode toggle (always visible) -->
                <Button Content="{Binding ModeLabel}" Command="{Binding ToggleRaceModeCommand}"
                        Background="#FFD700" Foreground="#1E1E2E" FontWeight="Bold" Padding="12,8"/>
            </WrapPanel>
        </Border>

        <!-- Row 1: Sliders (shared speed/bars/sound) -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Speed:" Margin="0,0,8,0"/>
                <Slider Value="{Binding SpeedValue}" Minimum="1" Maximum="100" Width="150"
                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding SpeedValue, StringFormat={}{0}}" Width="30" Margin="0,0,20,0"/>

                <TextBlock Text="Bars:" Margin="0,0,8,0"/>
                <Slider Value="{Binding BarCount}" Minimum="10" Maximum="500" Width="150"
                        VerticalAlignment="Center" Margin="0,0,8,0"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        IsEnabled="{Binding CanChangeSettings}"/>
                <TextBlock Text="{Binding BarCount}" Width="30" Margin="0,0,20,0"/>

                <Button Content="{Binding SoundIcon}" Command="{Binding ToggleSoundCommand}"
                        Background="#555566" Padding="8,8" FontSize="16" Margin="0,0,8,0"/>
                <TextBlock Text="Vol:" Margin="0,0,6,0"/>
                <Slider Value="{Binding Volume}" Minimum="0" Maximum="1" Width="100"
                        VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.1"/>
            </WrapPanel>
        </Border>

        <!-- ============ SINGLE MODE CONTENT ============ -->

        <!-- Row 2: Algorithm description (single mode) -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                Visibility="{Binding IsRaceMode, Converter={StaticResource InverseBoolToVisConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding AlgorithmDescription}" TextWrapping="Wrap" Opacity="0.85" FontSize="12"/>
                <TextBlock Text="{Binding AlgorithmComplexity}" Margin="0,4,0,0" FontSize="12"
                           FontWeight="SemiBold" Foreground="#5A9BD4"/>
            </StackPanel>
        </Border>

        <!-- Row 3: Single visualizer (single mode) -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="4" ClipToBounds="True"
                Visibility="{Binding IsRaceMode, Converter={StaticResource InverseBoolToVisConverter}}">
            <vis:SortVisualizer Items="{Binding Items}" RenderVersion="{Binding RenderVersion}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Border>

        <!-- Row 4: Status bar (single mode) -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0"
                Visibility="{Binding IsRaceMode, Converter={StaticResource InverseBoolToVisConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Comparisons:" Margin="0,0,6,0" Opacity="0.7"/>
                <TextBlock Text="{Binding Comparisons, StringFormat=N0}" Margin="0,0,24,0" FontWeight="SemiBold"/>
                <TextBlock Text="Swaps/Writes:" Margin="0,0,6,0" Opacity="0.7"/>
                <TextBlock Text="{Binding Swaps, StringFormat=N0}" Margin="0,0,24,0" FontWeight="SemiBold"/>
                <TextBlock Text="Time:" Margin="0,0,6,0" Opacity="0.7"/>
                <TextBlock Text="{Binding ElapsedTime}" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- ============ RACE MODE CONTENT ============ -->

        <!-- Row 2+3: Side-by-side visualizers (race mode) -->
        <Grid Grid.Row="2" Grid.RowSpan="2"
              Visibility="{Binding IsRaceMode, Converter={StaticResource BoolToVisConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left lane -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6,6,0,0" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Race.LeftLane.Algorithm.Name}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text=" — " Opacity="0.5"/>
                        <TextBlock Text="{Binding Race.LeftLane.Status}" Foreground="#5A9BD4" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="4" ClipToBounds="True">
                    <vis:SortVisualizer Items="{Binding Race.LeftLane.Items}" RenderVersion="{Binding Race.LeftLane.RenderVersion}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,6,6" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Comp:" Opacity="0.7" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Race.LeftLane.Comparisons, StringFormat=N0}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Text="Swaps:" Opacity="0.7" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Race.LeftLane.Swaps, StringFormat=N0}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Text="Time:" Opacity="0.7" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Race.LeftLane.ElapsedTime}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right lane -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6,6,0,0" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Race.RightLane.Algorithm.Name}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text=" — " Opacity="0.5"/>
                        <TextBlock Text="{Binding Race.RightLane.Status}" Foreground="#5A9BD4" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="4" ClipToBounds="True">
                    <vis:SortVisualizer Items="{Binding Race.RightLane.Items}" RenderVersion="{Binding Race.RightLane.RenderVersion}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,6,6" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Comp:" Opacity="0.7" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Race.RightLane.Comparisons, StringFormat=N0}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Text="Swaps:" Opacity="0.7" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Race.RightLane.Swaps, StringFormat=N0}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Text="Time:" Opacity="0.7" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Race.RightLane.ElapsedTime}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Row 4: Algorithm descriptions (race mode) -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0"
                Visibility="{Binding IsRaceMode, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Race.LeftLane.Algorithm.TimeComplexity}" FontSize="12" FontWeight="SemiBold" Foreground="#5A9BD4"/>
                    <TextBlock Text="{Binding Race.LeftLane.Algorithm.Description}" TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Race.RightLane.Algorithm.TimeComplexity}" FontSize="12" FontWeight="SemiBold" Foreground="#5A9BD4"/>
                    <TextBlock Text="{Binding Race.RightLane.Algorithm.Description}" TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
